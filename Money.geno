/// Money.geno — integer cents helpers (no floats in the ledger core).
/// ==================================================================

import String

/// Pad a 0..99 value to two decimal digits.
func pad2(n: Int) -> String
    requires n >= 0
    requires n < 100
    ensures length(result) == 2
    example 0 -> "00"
    example 5 -> "05"
    example 42 -> "42"
    if n < 10 then
        return "0" + to_string(n)
    else
        return to_string(n)
    end if
end func

func abs_int(n: Int) -> Int
    ensures result >= 0
    example 5 -> 5
    example (-5) -> 5
    example 0 -> 0
    if n < 0 then
        return 0 - n
    else
        return n
    end if
end func

/// Format an integer cent amount as a dollar string with two decimals.
func format_cents(cents: Int) -> String
    example 0 -> "$0.00"
    example 5 -> "$0.05"
    example 99 -> "$0.99"
    example 100 -> "$1.00"
    example 1234 -> "$12.34"
    example 10099 -> "$100.99"
    example (-50) -> "-$0.50"
    example (-1234) -> "-$12.34"
    var sign: String = ""
    var x: Int = cents
    if x < 0 then
        sign = "-"
        x = 0 - x
    end if
    let dollars: Int = x / 100
    let rem: Int = x % 100
    return sign + "$" + to_string(dollars) + "." + pad2(rem)
end func

/// Parse a bare integer cents argument via parse_int (Option → Result).
func parse_cents_arg(text: String) -> Result[Int, String]
    example "0" -> Ok(0)
    example "1234" -> Ok(1234)
    example "-50" -> Ok(-50)
    example "" -> Err("not an integer: ")
    example "x" -> Err("not an integer: x")
    example "12.34" -> Err("not an integer: 12.34")
    match parse_int(text) with
    | None -> return Err("not an integer: " + text)
    | Some(n) -> return Ok(n)
    end match
end func

/// Convert whole dollars + a 0..99 cents part into total cents.
func dollars_to_cents(dollars: Int, cents_part: Int) -> Result[Int, String]
    example 12, 34 -> Ok(1234)
    example 0, 5 -> Ok(5)
    example (-1), 50 -> Ok(-150)
    example 1, 0 -> Ok(100)
    example 1, 100 -> Err("cents_part must be 0..99")
    example 1, (-1) -> Err("cents_part must be 0..99")
    if cents_part < 0 or cents_part > 99 then
        return Err("cents_part must be 0..99")
    end if
    if dollars < 0 then
        return Ok(dollars * 100 - cents_part)
    else
        return Ok(dollars * 100 + cents_part)
    end if
end func

/// Parse a dollar string ("12.34", "12", "-1.50") into integer cents.
/// Fractional part, when present, must be exactly two digits.
func parse_dollars(text: String) -> Result[Int, String]
    example "12.34" -> Ok(1234)
    example "0.05" -> Ok(5)
    example "12" -> Ok(1200)
    example "-1.50" -> Ok(-150)
    example "0" -> Ok(0)
    example "1.5" -> Err("cents part must be exactly 2 digits")
    example "1.234" -> Err("cents part must be exactly 2 digits")
    example "abc" -> Err("not a dollar amount: abc")
    example "" -> Err("not a dollar amount: ")
    example ".50" -> Err("not a dollar amount: .50")
    let neg: Bool = starts_with(text, "-")
    var body: String = text
    if neg then
        body = String.substring(text: text, start: 1, stop: length(text))
    end if
    match split_once(body, ".") with
    | None ->
        match parse_int(body) with
        | None -> return Err("not a dollar amount: " + text)
        | Some(d) ->
            let cents: Int = d * 100
            if neg then
                return Ok(0 - cents)
            else
                return Ok(cents)
            end if
        end match
    | Some(pair) ->
        let (dollars_s, cents_s): (String, String) = pair
        if length(dollars_s) == 0 then
            return Err("not a dollar amount: " + text)
        end if
        if length(cents_s) != 2 then
            return Err("cents part must be exactly 2 digits")
        end if
        match parse_int(dollars_s) with
        | None -> return Err("not a dollar amount: " + text)
        | Some(d) ->
            match parse_int(cents_s) with
            | None -> return Err("not a dollar amount: " + text)
            | Some(c) ->
                match dollars_to_cents(dollars: d, cents_part: c) with
                | Err(e) -> return Err(e)
                | Ok(total) ->
                    if neg then
                        return Ok(0 - abs_int(total))
                    else
                        return Ok(total)
                    end if
                end match
            end match
        end match
    end match
end func
